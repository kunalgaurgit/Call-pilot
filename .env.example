GEMINI_API_KEY=your-free-key-from-aistudio.google.com
# comma-separated: tried in order when a model is busy (503/429)
GEMINI_MODEL=gemini-3.6-flash,gemini-3-flash-preview,gemini-3.5-flash
# minimal = fastest replies; low/medium/high think longer (smarter, slower)
GEMINI_THINKING=minimal
# gemini = real AI, fake = offline scripted demo
LLM_MODE=gemini
